# Copiá este archivo a .env y completá los valores. Nunca commitear .env.

# --- Base de datos (Postgres en Docker; ver docker-compose.yml) ---
POSTGRES_USER=hub
# Solo letras y números: la contraseña se usa dentro de una URL.
POSTGRES_PASSWORD=hub_dev_password
POSTGRES_DB=hub
DB_PORT=5433
# URL para correr la app en tu máquina (npm run dev). Con Docker Compose se arma sola.
DATABASE_URL="postgresql://hub:hub_dev_password@localhost:5433/hub?schema=public"

# --- App ---
APP_PORT=3100

# --- Sesión ---
# Clave que firma las sesiones (JWT). Mínimo 32 caracteres aleatorios.
# Generarla con:  openssl rand -base64 48
SESSION_SECRET=
# true detrás de HTTPS (producción). En desarrollo local por http poné false.
COOKIE_SECURE=false

# --- Seed (npm run db:seed) ---
# Con qué inicia sesión el administrador: un email o un nombre de usuario (ej. admin).
SEED_ADMIN_USERNAME=admin
# En desarrollo, si queda vacío se usa una contraseña de demo. En producción es obligatoria (mín. 12 caracteres).
SEED_ADMIN_PASSWORD=
# Igual que la anterior, para el empleado de demostración (solo se usa si SEED_DEMO=true).
SEED_EMPLOYEE_PASSWORD=
# Crea unidades, un empleado y datos de demostración. En producción solo con true.
SEED_DEMO=true

# --- Tests (opcional) ---
# Por defecto los tests usan la misma instancia de Postgres con la base "<nombre>_test".
# TEST_DATABASE_URL="postgresql://hub:hub_dev_password@localhost:5433/hub_test?schema=public"

# --- Fase 3 (todavía no se usan) ---
# Cifra los secretos de salida con AES-256-GCM. Generarla con:  openssl rand -base64 32
# ENCRYPTION_KEY=
